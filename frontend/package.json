{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "bun": "1.3.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "lint": "biome lint .",
    "lint:tokens": "bun scripts/check-design-tokens.mjs",
    "format": "biome format --write .",
    "check": "biome check . && bun scripts/check-design-tokens.mjs && bun scripts/check-discover-blurbs.mjs && bun scripts/check-message-codes.mjs && bun scripts/check-hint-coverage.mjs && bun scripts/check-hint-reasons.mjs && bun scripts/check-markdown-tables.mjs",
    "check:write": "biome check --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "docs:generate": "typedoc",
    "typecheck": "bun ./node_modules/typescript7/bin/tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "framer-motion": "^12.42.2",
    "howler": "^2.2.4",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
