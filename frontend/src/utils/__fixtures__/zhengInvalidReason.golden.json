        { "suit": 3, "value": 7 },
        { "suit": 4, "value": 8 }
      ],
      "table": [{ "suit": 1, "value": 9 }, { "suit": 2, "value": 10 }, { "suit": 3, "value": 11 }],
      "tablePlayType": 4,
      "reason": "wrongCount"
    },
    {
      "name": "the same type and count but weaker",
