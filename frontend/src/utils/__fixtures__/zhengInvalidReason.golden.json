      "table": [],
      "tablePlayType": 0,
      "reason": ""
    },
    {
      "name": "a mismatched pair is not a combination at all",
      "cards": [{ "suit": 1, "value": 5 }, { "suit": 2, "value": 6 }],
      "table": [],
      "tablePlayType": 0,
      "reason": "invalidType"
    },
    {
      "name": "a pair cannot answer a single",
      "cards": [{ "suit": 1, "value": 9 }, { "suit": 2, "value": 9 }],
      "table": [{ "suit": 3, "value": 5 }],
      "tablePlayType": 1,
      "reason": "wrongType"
    },
    {
      "name": "a longer straight does not answer a shorter one",
      "cards": [
        { "suit": 1, "value": 5 },
